{
  "name": "usd-n",
  "version": "0.1.0",
  "private": true,
  "description": "USD-N core protocol implementation with deterministic issuance, reserve enforcement, and replay verification.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "npm run build && node dist/main.js",
    "verify": "node dist/src/cli/verify.js",
    "test": "tsc -p tsconfig.json && node --test dist/src/engine/*.test.js",
    "dev": "tsc -w -p tsconfig.json",
    "serve": "node server.js",
    "serve:prod": "npm run build && node dist/main.js"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
