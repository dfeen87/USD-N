# USD-N Production API Environment Configuration
# Copy this file to .env and configure the values for your environment

# Environment (production, development, test)
# Affects error verbosity and logging behavior
USDN_ENV=production

# JWT Secret for API authentication
# Leave empty to disable authentication (not recommended for production)
# Generate a strong secret: openssl rand -base64 32
USDN_JWT_SECRET=

# Logging level (debug, info, warn, error)
# Use 'info' for production, 'debug' for development
USDN_LOG_LEVEL=info

# Unique node identifier
# Used for distributed deployments and audit trails
# Auto-generated if not provided
USDN_NODE_ID=

# Server port (default: 8080)
# Railway and other platforms may override this
PORT=8080
